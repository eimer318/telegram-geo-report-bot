# Copy this file to .env and keep the real file out of Git.
BOT_TOKEN=
ENCRYPTION_KEY=
BOT_CONFIG_FILE=config/bot.json
BOT_DATA_DIR=data
BOT_PHOTO_DIR=photos
NOMINATIM_USER_AGENT=TelegramGeoReportBot/1.0 (contact@example.invalid)
NOMINATIM_SEARCH_URL=https://nominatim.openstreetmap.org/search

# Optional Telegram channel integration.
TELEGRAM_CHANNEL_ID=
TELEGRAM_CHANNEL_ALLOW_WRITE=false
CHANNEL_DAILY_LIMIT=true

# Optional uMap synchronization. The encrypted session file is created by the
# interactive `umap session` command. Keep write access disabled until a
# reviewed dry-run succeeds.
UMAP_ALLOW_WRITE=false
UMAP_SESSION_FILE=data/umap_session.enc
UMAP_BACKUP_DIR=data/umap_backups
UMAP_USER_AGENT=TelegramGeoReportBot-uMap/1.0
